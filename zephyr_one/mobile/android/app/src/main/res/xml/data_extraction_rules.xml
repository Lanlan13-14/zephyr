<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device. The mirror is reconstructible from the server and the SecretStore is
     wrapped by a hardware-backed Keystore key that cannot be restored onto another device, so a
     backup could only ever produce an unopenable blob. DATA_AND_MIGRATION.md keeps rebinding as the
     supported recovery path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
