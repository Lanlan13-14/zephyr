{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr.local/contracts/sync-operation.schema.json",
  "title": "SyncOperation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "opId",
    "entityType",
    "entityId",
    "action",
    "baseRevision",
    "fieldMask",
    "payload"
  ],
  "properties": {
    "opId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "entityType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "entityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "action": {
      "enum": [
        "upsert",
        "delete",
        "restore"
      ]
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "clientModifiedAt": {
      "type": "integer",
      "minimum": 0
    },
    "fieldMask": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.\\[\\]-]*$"
      }
    },
    "payload": {
      "type": "object"
    },
    "secretEnvelopes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "secret-envelope.schema.json"
      }
    },
    "clearSecretFields": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    }
  },
  "allOf": [
    {
      "not": {
        "properties": {
          "secretEnvelopes": true,
          "clearSecretFields": true
        },
        "required": [
          "secretEnvelopes",
          "clearSecretFields"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "upsert"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "anyOf": [
          { "properties": { "fieldMask": { "type": "array", "minItems": 1 } } },
          { "properties": { "secretEnvelopes": { "type": "object", "minProperties": 1 } }, "required": ["secretEnvelopes"] },
          { "properties": { "clearSecretFields": { "type": "array", "minItems": 1 } }, "required": ["clearSecretFields"] }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "delete",
              "restore"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "fieldMask": {
            "type": "array",
            "maxItems": 0
          },
          "payload": {
            "type": "object",
            "maxProperties": 0
          },
          "secretEnvelopes": {
            "type": "object",
            "maxProperties": 0
          },
          "clearSecretFields": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
