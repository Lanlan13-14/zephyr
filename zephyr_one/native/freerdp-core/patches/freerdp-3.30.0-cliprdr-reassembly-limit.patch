diff --git a/channels/client/addin.c b/channels/client/addin.c
index 6ba1697..c6e8e4b 100644
--- a/channels/client/addin.c
+++ b/channels/client/addin.c
@@ -669 +669,17 @@ UINT channel_client_post_message(void* MsgsHandle, LPVOID pData, UINT32 dataLeng
-	if (dataFlags & CHANNEL_FLAG_FIRST)
+	const BOOL boundedCliprdr =
+	    internals->channel_name && (strcmp(internals->channel_name, "cliprdr") == 0);
+	if (boundedCliprdr &&
+	    ((totalLength > FREERDP_ZEPHYR_CLIPRDR_MAX_MESSAGE_BYTES) ||
+	     (dataLength > totalLength)))
+	{
+		/* This branch must stay before Stream_New/EnsureCapacity: totalLength is
+		 * controlled by the RDP server and can otherwise cause a large allocation
+		 * before the cliprdr PDU parser or application callback sees the bytes. */
+		WLog_ERR(TAG, "refusing oversized cliprdr message: chunk=%" PRIu32
+		              ", total=%" PRIu32, dataLength, totalLength);
+		Stream_Free(internals->data_in, TRUE);
+		internals->data_in = nullptr;
+		return ERROR_INVALID_DATA;
+	}
+
+	if (dataFlags & CHANNEL_FLAG_FIRST)
@@ -686 +702,15 @@ UINT channel_client_post_message(void* MsgsHandle, LPVOID pData, UINT32 dataLeng
-	if (!Stream_EnsureRemainingCapacity(data_in, dataLength))
+	if (boundedCliprdr)
+	{
+		const size_t position = Stream_GetPosition(data_in);
+		if ((position > totalLength) || (dataLength > totalLength - position))
+		{
+			/* Subtraction is reached only after position <= totalLength, so the
+			 * cumulative fragment check cannot wrap size_t. */
+			WLog_ERR(TAG, "refusing inconsistent cliprdr fragments");
+			Stream_Free(internals->data_in, TRUE);
+			internals->data_in = nullptr;
+			return ERROR_INVALID_DATA;
+		}
+	}
+
+	if (!Stream_EnsureRemainingCapacity(data_in, dataLength))
diff --git a/include/freerdp/client/channels.h b/include/freerdp/client/channels.h
index e27ce43..8e290d2 100644
--- a/include/freerdp/client/channels.h
+++ b/include/freerdp/client/channels.h
@@ -27,3 +27,11 @@
-#include <freerdp/channels/channels.h>
-
-#ifdef __cplusplus
+#include <freerdp/channels/channels.h>
+
+/* Zephyr One security contract: cliprdr static-channel messages are rejected
+ * before the generic reassembler allocates its server-controlled totalLength. */
+#define FREERDP_ZEPHYR_CLIPRDR_REASSEMBLY_LIMIT 1
+#define FREERDP_ZEPHYR_CLIPRDR_MAX_PAYLOAD_BYTES (4U * 1024U * 1024U)
+#define FREERDP_ZEPHYR_CLIPRDR_HEADER_BYTES 8U
+#define FREERDP_ZEPHYR_CLIPRDR_MAX_MESSAGE_BYTES \
+	(FREERDP_ZEPHYR_CLIPRDR_MAX_PAYLOAD_BYTES + FREERDP_ZEPHYR_CLIPRDR_HEADER_BYTES)
+
+#ifdef __cplusplus
