{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for Zephyr One",
  "windows": ["main"],
  "permissions": [
    "allow-get-platform",
    "allow-get-app-version",
    "allow-auth-capabilities",
    "allow-auth-unlock",
    "allow-set-theme-icon",
    "allow-runtime-start",
    "allow-runtime-enter",
    "allow-runtime-info",
    "allow-runtime-stop",
    "allow-local-app-ready",
    "allow-agent-pick-directory",
    "allow-agent-default-share-path",
    "allow-agent-fs-list",
    "allow-agent-fs-stat",
    "allow-agent-fs-open",
    "allow-agent-fs-read",
    "allow-agent-fs-write",
    "allow-agent-fs-close",
    "allow-agent-fs-mkdir",
    "allow-agent-fs-delete",
    "allow-agent-fs-rename",
    "allow-agent-fs-truncate",
    "allow-token-list-local",
    "allow-token-add-local",
    "allow-token-remove-local",
    "allow-token-export-local",
    "allow-token-import-local",
    "allow-rdp-native-capabilities",
    "allow-rdp-native-connect",
    "allow-rdp-native-disconnect",
    "allow-rdp-native-sessions",
    "allow-rdp-native-send-mouse",
    "allow-rdp-native-send-key",
    "allow-rdp-native-send-text",
    "allow-rdp-native-resize",
    "allow-rdp-native-set-clipboard",
    "allow-rdp-native-request-full-frame",
    "allow-rdp-native-session-state",
    "allow-rdp-native-surface-create",
    "allow-rdp-native-surface-show",
    "allow-rdp-native-surface-close",
    "allow-rdp-native-surface-resize",
    "allow-rdp-native-surface-focus",
    "allow-rdp-native-surface-status",
    "allow-rdp-native-surface-capture",
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:path:default",
    "core:app:default",
    "dialog:default",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-stat",
    "http:default",
    "os:default",
    "process:default",
    "shell:allow-open",
    "store:default"
  ]
}
