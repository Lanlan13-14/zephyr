{
  "name": "zephyr-one",
  "version": "0.1.0",
  "private": true,
  "description": "Zephyr One — full Zephyr product in Electron; remote main is sync-only",
  "author": "Zephyr <noreply@users.noreply.github.com>",
  "homepage": "https://github.com/Lanlan13-14/zephyr",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "python3 scripts/prepare-icons.py",
    "stage:core": "sh scripts/stage-zephyr-core.sh",
    "stage:desktop": "npm run stage:core && node scripts/stage-desktop-runtime.mjs",
    "electron:dev": "npm run stage:desktop && concurrently -k \"vite\" \"wait-on http://127.0.0.1:1420 && ELECTRON_RENDERER_URL=http://127.0.0.1:1420 electron .\"",
    "electron:build": "npm run stage:desktop && npm run build && electron-builder",
    "dist": "npm run electron:build",
    "test:unit": "node --test tests/*.test.mjs",
    "test:protocol": "node --test tests/zft2-protocol.test.mjs",
    "test:ci": "npm run test:unit && npm run test:protocol"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^37.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.0",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.zephyr.one",
    "productName": "Zephyr One",
    "copyright": "Zephyr",
    "executableName": "zephyr-one",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "index.html",
      "src/**",
      "package.json"
    ],
    "asarUnpack": [
      "electron/windows-hello.ps1"
    ],
    "extraResources": [
      {
        "from": "zephyr-core",
        "to": "zephyr-core",
        "filter": [
          "**/*",
          "!node_modules"
        ]
      },
      {
        "from": "zephyr-core/node_modules",
        "to": "zephyr-core/node_modules"
      },
      {
        "from": "desktop-runtime",
        "to": "desktop-runtime"
      },
      {
        "from": "src-tauri/runtime-icons",
        "to": "runtime-icons"
      }
    ],
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "zephyr-one-windows-x64-${version}.exe",
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "zephyr-one-windows-portable-${version}.exe"
    },
    "mac": {
      "icon": "src-tauri/icons/icon.icns",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "zephyr-one-macos-${version}.${ext}",
      "x64ArchFiles": "Contents/Resources/desktop-runtime/**"
    },
    "linux": {
      "icon": "src-tauri/icons",
      "category": "Utility",
      "maintainer": "Zephyr <noreply@users.noreply.github.com>",
      "target": [
        "deb",
        "rpm"
      ],
      "artifactName": "zephyr-one-linux-x64-${version}.${ext}"
    }
  }
}
