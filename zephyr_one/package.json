{
  "name": "zephyr-one",
  "version": "0.1.0",
  "private": true,
  "description": "Zephyr One — full Zephyr product in Tauri; remote main is sync-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "python3 scripts/prepare-icons.py",
    "stage:core": "sh scripts/stage-zephyr-core.sh",
    "stage:desktop": "npm run stage:core && node scripts/stage-desktop-runtime.mjs",
    "pretauri:dev": "npm run stage:desktop",
    "pretauri:build": "npm run stage:desktop",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:unit": "node --test tests/*.test.mjs",
    "test:protocol": "node --test tests/zft2-protocol.test.mjs",
    "test:ci": "npm run test:unit && npm run test:protocol"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.2",
    "@tauri-apps/plugin-http": "^2.5.2",
    "@tauri-apps/plugin-os": "^2.3.1",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-shell": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "esbuild": "^0.28.0",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}
