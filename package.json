{
  "name": "zephyr-ssh",
  "version": "3.0.0",
  "description": "Secure WebSSH terminal management system with SQLite storage, Passkey, TOTP and data backup.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:editor": "esbuild public/editor/src/zephyr-editor.js --bundle --format=esm --target=es2020 --outfile=public/editor/zephyr-editor.bundle.js --minify",
    "build:terminal": "node scripts/build-xterm-headless.mjs && node scripts/transpile-wterm.mjs core && node scripts/transpile-wterm.mjs dom",
    "build:terminal:wasm": "BUILD_WASM=1 bash scripts/build-wterm.sh",
    "test": "npm run test:rdp-node",
    "test:xterm-bridge": "node --test tests/xterm-bridge-contract.test.mjs",
    "test:rdp-node": "node --test tests/*.test.mjs",
    "test:syntax": "node tests/check-js-syntax.mjs",
    "test:go": "cd rdp-wasm/grdp-patch && GOOS=js GOARCH=wasm go test -exec=\"$(pwd)/../../tests/go-js-wasm-exec-clean.sh\" ./plugin/rdpgfx ./plugin/cliprdr ./protocol/nla && cd .. && GOOS=js GOARCH=wasm go test -exec=\"$(pwd)/../tests/go-js-wasm-exec-clean.sh\" ./...",
    "test:motion-go": "cd motion-wasm && go test ./...",
    "test:motion": "node --test tests/motion-spring-js.test.mjs tests/motion-runtime.test.mjs tests/motion-abi.test.mjs",
    "test:wasm-build": "cd rdp-wasm && GOOS=js GOARCH=wasm go build -o /tmp/zephyr-rdp-main.wasm . && test -s /tmp/zephyr-rdp-main.wasm && rm -f /tmp/zephyr-rdp-main.wasm",
    "test:browser-smoke": "node tests/rdp-browser-smoke-runner.mjs",
    "test:ci": "npm run test:syntax && npm run test:rdp-node && npm run test:motion && npm run test:go && npm run test:motion-go && npm run test:wasm-build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/lsp-client": "^6.2.4",
    "@codemirror/merge": "^6.12.1",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@lezer/highlight": "^1.2.3",
    "@noble/post-quantum": "^0.6.1",
    "@novnc/novnc": "^1.7.0",
    "@simplewebauthn/server": "^13.3.0",
    "@uiw/codemirror-theme-github": "^4.25.10",
    "@xterm/headless": "^6.0.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^11.10.0",
    "brace-expansion": "^2.1.2",
    "codemirror": "^6.0.2",
    "express": "^4.18.2",
    "ipaddr.js": "^2.3.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "prettier": "^3.8.3",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "ssh2": "^1.15.0",
    "unzipper": "^0.12.3",
    "viewerjs": "^1.11.7",
    "vscode-json-languageservice": "^5.7.2",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-ws-jsonrpc": "^3.5.0",
    "ws": "^8.16.0",
    "yaml-language-server": "^1.23.0"
  },
  "author": "",
  "license": "GPL-3.0",
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
