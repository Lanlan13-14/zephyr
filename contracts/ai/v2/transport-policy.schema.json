{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr.local/contracts/ai/v2/transport-policy.schema.json",
  "title": "TransportPolicyV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "dns", "tlsMinVersion", "dialTimeoutMs", "retry", "revision"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "dns": { "enum": ["system", "host-resolved", "literal"] },
    "tlsMinVersion": { "enum": ["1.2", "1.3"] },
    "dialTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
    "proxyUrl": { "type": ["string", "null"], "maxLength": 2048 },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAttempts", "baseDelayMs", "maxDelayMs"],
      "properties": {
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 8 },
        "baseDelayMs": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "maxDelayMs": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "revision": { "$ref": "common.schema.json#/$defs/revision" }
  },
  "$defs": {
    "dialTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip", "family", "ttl"],
      "properties": {
        "ip": { "type": "string", "minLength": 2, "maxLength": 64 },
        "family": { "enum": ["ipv4", "ipv6"] },
        "ttl": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    },
    "transportTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestUrl",
        "effectiveHost",
        "effectivePort",
        "dialTargets",
        "tlsServerName",
        "resolutionSource",
        "dialTimeoutMs"
      ],
      "properties": {
        "requestUrl": { "$ref": "common.schema.json#/$defs/uri" },
        "effectiveHost": { "type": "string", "minLength": 1, "maxLength": 253 },
        "effectivePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "dialTargets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/dialTarget" }
        },
        "tlsServerName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "resolutionSource": { "enum": ["android-jvm-dns", "ios-system-dns", "desktop-system-dns", "literal"] },
        "dialTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 }
      }
    }
  }
}
