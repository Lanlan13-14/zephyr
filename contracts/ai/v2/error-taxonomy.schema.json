{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr.local/contracts/ai/v2/error-taxonomy.schema.json",
  "title": "AIErrorTaxonomyV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "errors"],
  "properties": {
    "version": { "const": 2 },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/errorSpec" }
    }
  },
  "$defs": {
    "errorSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "httpStatus", "retryable", "clientAction"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "httpStatus": { "type": "integer", "minimum": 400, "maximum": 599 },
        "retryable": { "type": "boolean" },
        "clientAction": { "enum": ["fix_input", "reauthenticate", "retry", "abort", "upgrade"] }
      }
    }
  }
}
