# Dependencies
node_modules/
.tooling/

# Runtime data and secrets
data/.env
data/crypto/
data/terminal-history/
data/*.db
data/*.db-shm
data/*.db-wal
data/*.enc
data/zephyr-before-import-*.db

# Logs
*.log
npm-debug.log*

# Motion engine: local verification builds (CI commits the TinyGo artifact
# at public/vendor/zephyr-motion/zephyr_motion.wasm — do NOT ignore that one)
motion-wasm/*.wasm
/tmp_*.wasm

# OS / editor
.DS_Store
.vscode/

# Flutter / Dart
zephyr_agent/.dart_tool/
zephyr_agent/.packages
zephyr_agent/.pub-cache/
zephyr_agent/.pub/
zephyr_agent/build/
zephyr_agent/.flutter-plugins
zephyr_agent/.flutter-plugins-dependencies
zephyr_agent/pubspec.lock
zephyr_agent/android/.gradle/
zephyr_agent/android/local.properties
zephyr_agent/android/app/debug/
zephyr_agent/android/app/profile/
zephyr_agent/android/app/release/
zephyr_agent/ios/Pods/
zephyr_agent/ios/.symlinks/
zephyr_agent/macos/Pods/
zephyr_agent/macos/.symlinks/
*.jks
*.keystore

# Agent token data
data/agent-tokens.json
# xterm.js vendored tree — local toolchain artifacts only
xterm/node_modules/
xterm/out/
xterm/lib/
xterm/lib-headless/
xterm/out-test/
__pycache__/

# Vendored FreeRDP build tree and its vcpkg deps (never committed)
zephyr_one/native/freerdp-core/.freerdp-dist/
zephyr_one/native/freerdp-core/vcpkg_installed/
zephyr_one/vcpkg_installed/
# pnpm local store. .pnpm-store/v11/projects/<hash> is a junction back to
# zephyr_one/, so committing it would duplicate that whole subtree.
.pnpm-store/
/pnpm-lock.yaml
/pnpm-workspace.yaml

# Local agent and CI scratch artifacts
/.codex/
/.agent-tmp-*
/.ci_log_*
/zephyr_one/.agent-tmp-*/

# Zephyr One Android build outputs and Gradle state
/zephyr_one/mobile/android/.gradle/
/zephyr_one/mobile/android/build/
/zephyr_one/mobile/android/*/build/
/zephyr_one/mobile/android/buildSrc/.gradle/
/zephyr_one/mobile/android/buildSrc/build/
/zephyr_one/mobile/android/.kotlin/
/zephyr_one/mobile/android/buildSrc/.kotlin/

# Local native build helpers and object files
/*.obj
/*.pdb
/zephyr_one/local-build.bat

# Local database-import journal authentication key
/data/.zephyr-import-journal-auth.v1.key

# Zephyr One iOS SwiftPM local state
/zephyr_one/mobile/ios/.build/
/zephyr_one/mobile/ios/Package.resolved

# Zephyr AI runtime archive database
/zephyr-ai/internal/server/archive/*.sqlite
