# Dependencies
node_modules/
.tooling/

# Runtime data and secrets
data/.env
data/crypto/
data/terminal-history/
data/*.db
data/*.db-shm
data/*.db-wal
data/*.enc
data/zephyr-before-import-*.db

# Logs
*.log
npm-debug.log*

# Motion engine: local verification builds (CI commits the TinyGo artifact
# at public/vendor/zephyr-motion/zephyr_motion.wasm — do NOT ignore that one)
motion-wasm/*.wasm
/tmp_*.wasm

# OS / editor
.DS_Store
.vscode/

# Flutter / Dart
zephyr_agent/.dart_tool/
zephyr_agent/.packages
zephyr_agent/.pub-cache/
zephyr_agent/.pub/
zephyr_agent/build/
zephyr_agent/.flutter-plugins
zephyr_agent/.flutter-plugins-dependencies
zephyr_agent/pubspec.lock
zephyr_agent/android/.gradle/
zephyr_agent/android/local.properties
zephyr_agent/android/app/debug/
zephyr_agent/android/app/profile/
zephyr_agent/android/app/release/
zephyr_agent/ios/Pods/
zephyr_agent/ios/.symlinks/
zephyr_agent/macos/Pods/
zephyr_agent/macos/.symlinks/
*.jks
*.keystore

# Agent token data
data/agent-tokens.json
# xterm.js vendored tree — local toolchain artifacts only
xterm/node_modules/
xterm/out/
xterm/lib/
xterm/lib-headless/
xterm/out-test/
__pycache__/

# Zephyr One native RDP helper (FreeRDP)
#
# The crate is source-only in git. `target/` is a multi-hundred-MB cargo build
# tree, and `native-bin/` holds the staged release binary that
# scripts/stage-native-rdp-bin.sh produces per platform — both are build
# outputs, rebuilt by CI for each target triple.
zephyr_one/native/zephyr-one-rdp/target/
zephyr_one/native-bin/

# Staged core: stage-zephyr-core.sh regenerates it (server.js + public/ copy
# plus the native-RDP transform), so committing it would duplicate the repo.
zephyr_one/zephyr-core/

# Vendored FreeRDP build tree and vcpkg deps (never committed)
zephyr_one/native/zephyr-one-rdp/.freerdp-dist/
zephyr_one/vcpkg_installed/
vcpkg_installed/
