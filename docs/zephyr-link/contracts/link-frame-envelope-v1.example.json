{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zephyr.local/contracts/zephyr-link/link-frame-envelope-v1.example.json",
  "title": "Zephyr Link Versioned Business Frame Envelope Example",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocolVersion",
    "schemaVersion",
    "kind",
    "operation",
    "requestId",
    "idempotencyKey",
    "deviceId",
    "bindingGeneration",
    "capability",
    "deadlineAt",
    "body"
  ],
  "properties": {
    "protocol": { "const": "zephyr-link" },
    "protocolVersion": { "type": "integer", "minimum": 2 },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "kind": { "$ref": "#/$defs/kind" },
    "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$", "maxLength": 96 },
    "requestId": { "type": "string", "pattern": "^req_[A-Za-z0-9_-]{8,96}$" },
    "idempotencyKey": { "type": "string", "pattern": "^idem_[A-Za-z0-9_-]{8,128}$" },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "bindingGeneration": { "type": "string", "minLength": 1, "maxLength": 160 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$", "maxLength": 96 },
    "sessionId": { "type": ["string", "null"], "maxLength": 160 },
    "sessionEpoch": { "type": ["integer", "null"], "minimum": 1 },
    "deadlineAt": { "type": "integer", "minimum": 0 },
    "body": { "type": "object" }
  },
  "$defs": {
    "kind": { "type": "integer", "minimum": 1, "maximum": 16 }
  }
}
