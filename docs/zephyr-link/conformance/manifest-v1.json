{
  "suite": "ZEPHYR-LINK-CONFORMANCE",
  "version": "1.0.0",
  "purpose": "Anti-bypass compatibility, authorization and writer-safety checks. Documentation-only until an actual production adapter is supplied.",
  "categories": [
    "sync-envelope",
    "agent-policy",
    "webdav-writers"
  ],
  "requirements": {
    "productionAdapterRequiredForProductEvidence": true,
    "sameVectorsAcrossNodeGoKotlinSwift": true,
    "malformedInputsMustFailClosed": true,
    "everyCriticalMutationMustBeKilled": true,
    "skipTodoAndNotRunAreNotPass": true,
    "docVerificationIsNotProductVerification": true,
    "productionRequiredCasesCannotCountAsPassed": true,
    "sourceMutationWitnessMustExerciseActualProductionFunction": true,
    "highRiskContractChangesRequireIndependentReview": true
  },
  "commands": {
    "reference": "node docs/zephyr-link/conformance/run-conformance.mjs",
    "sourceMutations": "node docs/zephyr-link/conformance/run-source-mutations.mjs",
    "schemaAndLinks": "node docs/zephyr-link/verify-docs.mjs"
  },
  "productionAdapterContract": "docs/zephyr-link/conformance/PRODUCTION-ADAPTER-CONTRACT.md",
  "minimumVectorIds": {
    "syncEnvelope": 64,
    "agentPolicy": 109,
    "webdavWriters": 72
  },
  "requiredSourceMutations": 20,
  "requiredAntiBypassGuards": 11,
  "requiredCaseIds": [
    "SE-REJECT-002",
    "SE-REJECT-003",
    "SE-REJECT-005",
    "SE-REJECT-007",
    "SE-REJECT-008",
    "SE-REJECT-015",
    "SE-BOUNDARY-001",
    "SE-BOUNDARY-010",
