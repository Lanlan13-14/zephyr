+static UINT zephyr_cliprdr_server_file_contents_response(CliprdrClientContext* context,
+                                                          const CLIPRDR_FILE_CONTENTS_RESPONSE* resp)
+{
+	xfClipboard* clipboard;
+	if (!context || !resp || !context->custom)
+		return ERROR_INTERNAL_ERROR;
+	clipboard = (xfClipboard*)context->custom;
+
+	if (resp->msgFlags != CB_RESPONSE_OK)
+	{
+		clipboard->fileContentsSuccess = FALSE;
+		if (clipboard->fileDownloadEvent)
+			SetEvent(clipboard->fileDownloadEvent);
+		return CHANNEL_RC_OK;
+	}
+
+	if (clipboard->fileContentsData)
+	{
+		free(clipboard->fileContentsData);
+		clipboard->fileContentsData = NULL;
+	}
+	clipboard->fileContentsSize = resp->cbRequested;
+	clipboard->fileContentsData = (BYTE*)malloc(resp->cbRequested);
+	if (!clipboard->fileContentsData)
+	{
+		clipboard->fileContentsSuccess = FALSE;
+		if (clipboard->fileDownloadEvent)
+			SetEvent(clipboard->fileDownloadEvent);
+		return ERROR_NOT_ENOUGH_MEMORY;
+	}
+	CopyMemory(clipboard->fileContentsData, resp->requestedData, resp->cbRequested);
+	clipboard->fileContentsSuccess = TRUE;
+
+	if (clipboard->fileDownloadEvent)
+		SetEvent(clipboard->fileDownloadEvent);
+	return CHANNEL_RC_OK;
+}
+
+static UINT zephyr_download_remote_file(CliprdrClientContext* context, UINT32 listIndex,
+                                         UINT64* fileSize, const char* dirPath,
+                                         const WCHAR* wFileName)
+{
+	xfClipboard* clipboard;
+	CLIPRDR_FILE_CONTENTS_REQUEST req;
+	UINT rc;
+	char fileName[520];
+	char filePath[600];
+	FILE* fp;
+	UINT64 remaining, offset;
+	UINT32 chunkSize;
+
+	if (!context || !fileSize || !dirPath || !wFileName)
+		return ERROR_BAD_ARGUMENTS;
+	clipboard = (xfClipboard*)context->custom;
+	if (!clipboard)
+		return ERROR_INTERNAL_ERROR;
+
+	{
+		int len = ConvertFromUnicode(CP_UTF8, 0, wFileName, -1, fileName, sizeof(fileName), NULL, NULL);
+		if (len <= 0)
+			return ERROR_INTERNAL_ERROR;
+	}
+
+	{
+		char* base = fileName;
+		char* p;
+		for (p = fileName; *p; p++)
+		{
+			if (*p == '/' || *p == '\\')
+				base = p + 1;
+		}
+		if (base != fileName)
+			memmove(fileName, base, strlen(base) + 1);
+	}
+
+	ZeroMemory(&req, sizeof(req));
+	req.streamId = 1;
+	req.listIndex = listIndex;
+	req.dwFlags = FILECONTENTS_SIZE;
+	req.cbRequested = sizeof(UINT64);
+
+	clipboard->fileContentsData = NULL;
+	clipboard->fileContentsSuccess = FALSE;
+	if (clipboard->fileDownloadEvent)
+		ResetEvent(clipboard->fileDownloadEvent);
+
+	rc = context->ClientFileContentsRequest(context, &req);
+	if (rc != CHANNEL_RC_OK)
+		return rc;
+
+	if (clipboard->fileDownloadEvent)
+	{
+		if (WaitForSingleObject(clipboard->fileDownloadEvent, 5000) != WAIT_OBJECT_0)
+			return ERROR_TIMEOUT;
+	}
+
+	if (!clipboard->fileContentsSuccess || !clipboard->fileContentsData ||
+	    clipboard->fileContentsSize < sizeof(UINT64))
+	{
+		free(clipboard->fileContentsData);
+		clipboard->fileContentsData = NULL;
+		return ERROR_INTERNAL_ERROR;
+	}
+
+	CopyMemory(fileSize, clipboard->fileContentsData, sizeof(UINT64));
+	free(clipboard->fileContentsData);
+	clipboard->fileContentsData = NULL;
+
+	if (*fileSize == 0)
+	{
+		snprintf(filePath, sizeof(filePath), "%s/%s", dirPath, fileName);
+		fp = fopen(filePath, "wb");
+		if (fp)
+			fclose(fp);
+		return CHANNEL_RC_OK;
+	}
+
+	snprintf(filePath, sizeof(filePath), "%s/%s", dirPath, fileName);
+	fp = fopen(filePath, "wb");
+	if (!fp)
+		return ERROR_OPEN_FAILED;
+
+	remaining = *fileSize;
+	offset = 0;
+	chunkSize = 4 * 1024 * 1024;
+
+	while (remaining > 0)
+	{
+		UINT32 requestSize = (remaining < chunkSize) ? (UINT32)remaining : chunkSize;
+
+		ZeroMemory(&req, sizeof(req));
+		req.streamId = 1;
+		req.listIndex = listIndex;
+		req.dwFlags = FILECONTENTS_RANGE;
+		req.nPositionLow = (UINT32)(offset & 0xFFFFFFFF);
+		req.nPositionHigh = (UINT32)(offset >> 32);
+		req.cbRequested = requestSize;
+
+		clipboard->fileContentsData = NULL;
+		clipboard->fileContentsSuccess = FALSE;
+		if (clipboard->fileDownloadEvent)
+			ResetEvent(clipboard->fileDownloadEvent);
+
+		rc = context->ClientFileContentsRequest(context, &req);
+		if (rc != CHANNEL_RC_OK)
+		{
+			fclose(fp);
+			return rc;
+		}
+
+		if (clipboard->fileDownloadEvent)
+		{
+			if (WaitForSingleObject(clipboard->fileDownloadEvent, 10000) != WAIT_OBJECT_0)
+			{
+				fclose(fp);
+				return ERROR_TIMEOUT;
+			}
+		}
+
+		if (!clipboard->fileContentsSuccess || !clipboard->fileContentsData)
+		{
+			fclose(fp);
+			return ERROR_INTERNAL_ERROR;
+		}
+
+		if (fwrite(clipboard->fileContentsData, 1, clipboard->fileContentsSize, fp) != clipboard->fileContentsSize)
+		{
+			free(clipboard->fileContentsData);
+			clipboard->fileContentsData = NULL;
+			fclose(fp);
+			return ERROR_WRITE_FAULT;
+		}
+
+		free(clipboard->fileContentsData);
+		clipboard->fileContentsData = NULL;
+
+		offset += clipboard->fileContentsSize;
+		remaining -= clipboard->fileContentsSize;
+	}
+
+	fclose(fp);
+	WLog_INFO(TAG, "Zephyr: downloaded clipboard file '%s' (%llu bytes)", fileName,
+	          (unsigned long long)*fileSize);
+	return CHANNEL_RC_OK;
+}
+
+static UINT zephyr_download_clipboard_files(xfClipboard* clipboard, const BYTE* data, UINT32 size)
+{
+	FILEDESCRIPTORW* fileArray = NULL;
+	UINT32 fileCount = 0;
+	UINT32 i;
+	UINT rc;
+	UINT64 totalSize = 0;
+	const char* dir;
+	char dirPath[512];
+
+	if (!clipboard || !clipboard->context || !data || size < 4)
+		return ERROR_BAD_ARGUMENTS;
+
+	rc = cliprdr_parse_file_list(data, size, &fileArray, &fileCount);
+	if (rc != 0)
+	{
+		WLog_ERR(TAG, "Zephyr: failed to parse clipboard file list: 0x%08X", rc);
+		return rc;
+	}
+
+	WLog_INFO(TAG, "Zephyr: clipboard has %u remote files", fileCount);
+
+	dir = getenv("ZEPHYR_RDP_CLIPBOARD_DOWNLOAD_DIR");
+	if (!dir || !*dir)
+		dir = "/tmp";
+
+	snprintf(dirPath, sizeof(dirPath), "%s/zephyr-clip-%d", dir, (int)getpid());
+	mkdir(dirPath, 0755);
+
+	for (i = 0; i < fileCount; i++)
+	{
+		UINT64 fileSize = 0;
+
+		if (fileArray[i].dwFileAttributes & 0x10)
+		{
+			WLog_INFO(TAG, "Zephyr: skipping directory in clipboard");
+			continue;
+		}
+
+		rc = zephyr_download_remote_file(clipboard->context, i, &fileSize, dirPath,
+		                                   fileArray[i].cFileName);
+		if (rc != CHANNEL_RC_OK)
+			WLog_WARN(TAG, "Zephyr: failed to download clipboard file %u: 0x%08X", i, rc);
+		else
+			totalSize += fileSize;
+	}
+
+	if (clipboard->delegate->basePath)
+		free(clipboard->delegate->basePath);
+
+	{
+		char basePath[600];
+		snprintf(basePath, sizeof(basePath), "file://%s", dirPath);
+		clipboard->delegate->basePath = _strdup(basePath);
+	}
+
+	free(fileArray);
+	WLog_INFO(TAG, "Zephyr: clipboard file download complete, total %llu bytes",
+	          (unsigned long long)totalSize);
+	return CHANNEL_RC_OK;
+}
